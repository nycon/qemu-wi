# Application
APP_NAME="QEMU Interface"
DEBUG=false
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-64

# Public self-signup (POST /api/v1/auth/register). Keep false in production.
ALLOW_PUBLIC_REGISTRATION=false
# Swagger/ReDoc at /api/docs (also enabled when DEBUG=true)
EXPOSE_API_DOCS=false

# Database
DATABASE_URL=postgresql+asyncpg://qemu:qemu@localhost:5432/qemu_interface

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=your-jwt-secret-generate-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Host Agent
HOST_AGENT_URL=https://localhost:8443
HOST_AGENT_TOKEN=your-agent-token

# Storage
DEFAULT_STORAGE_POOL_PATH=/var/lib/qemu-interface/storage
CLOUD_IMAGES_PATH=/var/lib/qemu-interface/images
CLOUD_INIT_PATH=/var/lib/qemu-interface/cloud-init

# Network
DEFAULT_BRIDGE=br0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Email / SMTP (optional)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=QEMU Interface
SMTP_USE_TLS=true
SMTP_ALLOW_INVALID_CERT=false
